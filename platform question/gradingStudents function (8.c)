
#include <stdio.h>

int* gradingStudents(int grades_count, int* grades, int* result) {
    for (int i = 0; i < grades_count; i++) {
        if (grades[i] < 38) {
            result[i] = grades[i];
        }
        else {
            int next = ((grades[i] / 5) + 1) * 5;

            if (next - grades[i] < 3) {
                result[i] = next;
            }
            else {
                result[i] = grades[i];
            }
        }
    }

    return result;
}

int main() {
    int n;
    scanf("%d", &n);

    int grades[n], result[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &grades[i]);
    }

    gradingStudents(n, grades, result);

    for (int i = 0; i < n; i++) {
        printf("%d\n", result[i]);
    }

    return 0;
}
