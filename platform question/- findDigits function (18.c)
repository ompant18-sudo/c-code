#include <stdio.h>

int findDigits(int n) {
    int temp = n;
    int count = 0;

    while (temp > 0) {
        int digit = temp % 10;

        if (digit != 0 && n % digit == 0) {
            count++;
        }

        temp /= 10;
    }

    return count;
}

int main() {
    int t, n;

    scanf("%d", &t);

    while (t--) {
        scanf("%d", &n);
        printf("%d\n", findDigits(n));
    }

    return 0;
}
